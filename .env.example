# GitHub Personal Access Token for Models API (free, open-source models)
# Get one at: https://github.com/settings/tokens
# Scopes: 'read:user' is sufficient

# Optional: Per-Agent Model Configuration
# Defaults optimize for each agent's specific role
# Available models: phi-3-mini, phi-3-medium, mistral-7b, mistral-large,
# llama-2-7b, llama-2-13b, llama-2-70b, codestral-latest, and more
# SENTRY_MODEL=phi-3-medium
# STRATEGIST_MODEL=mistral-7b
# ARCHITECT_MODEL=llama-2-70b
# DEVELOPER_MODEL=codestral-latest
# VALIDATOR_MODEL=mistral-7b

# Optional: GitHub token for fetching private repo issues (different from Models token)
# GITHUB_REPO_TOKEN=ghp_your-github-token-here

# Optional: Default Qiskit repo target
# QISKIT_REPO=Qiskit/qiskit

# Optional: Max repair iterations for the Developer ⇄ Validator loop
# MAX_REPAIR_ITERATIONS=3

# Optional: LLM Provider (currently: 'github-models')
# LLM_PROVIDER=github-models
